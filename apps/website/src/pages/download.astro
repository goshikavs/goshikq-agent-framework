---
import Marketing from "../layouts/Marketing.astro";
import { SITE } from "../lib/site";

const archives = [
  { platform: "Linux AMD64", file: "goshikq-1.0.0-rc.2-linux-amd64.tar.gz", sha256: "6919ccd70cad3febcf10555db028c4b751a14d6f44179979d8eb74c803ebdec8", experimental: false },
  { platform: "Linux ARM64", file: "goshikq-1.0.0-rc.2-linux-arm64.tar.gz", sha256: "29a49afe0f57e2abf8d37460d2db1bfd7efafe03983f4b148fc3a08b06782b0f", experimental: false },
  { platform: "macOS Intel", file: "goshikq-1.0.0-rc.2-macos-amd64.tar.gz", sha256: "8d7b415a45fbc746b633c5e66f5c5cd61687d61fbcb4def43316db8156b7323e", experimental: false },
  { platform: "macOS Apple Silicon", file: "goshikq-1.0.0-rc.2-macos-arm64.tar.gz", sha256: "92cf0e3bda86d1649b7293a9fd5a0c2ef1389d38042409a1744087099553ddb5", experimental: false },
  { platform: "Windows AMD64", file: "goshikq-1.0.0-rc.2-windows-amd64.zip", sha256: "8ee11215af1d9912c97d4928c7ef9fe960232de41685abbb4e7f3b0481414af0", experimental: false },
  { platform: "Windows ARM64", file: "goshikq-1.0.0-rc.2-windows-arm64.zip", sha256: "7367c0b732474d369e463a45575ca30369652f5366f6d55a2a3c6806ea71a75c", experimental: true },
];
---
<Marketing title="Install Goshikq v1.0.0-rc.2" description="Download the Goshikq GitHub prerelease archives or install the unpublished Python and TypeScript SDKs from source." path="/download/">
  <section class="hero wrap prose">
    <p class="kicker">Install</p>
    <h1>Install the release candidate</h1>
    <p class="lede"><strong>This is a GitHub prerelease, not stable v1.0.</strong> The latest public native archives are <a href={SITE.githubPrerelease}><code>v1.0.0-rc.2</code></a>. <code>v1.0.0-rc.1</code> is superseded because it shipped <code>jsonwebtoken</code> 9.3.1 (GHSA-h395-gr6q-cpjc / CVE-2026-25537). There is still no PyPI, npm, or crates.io package. Python <code>{SITE.pythonPackage}=={SITE.pythonVersion}</code> and TypeScript <code>{SITE.tsPackage}@{SITE.tsVersion}</code> install from source. <strong>v1.0.0 is not tagged.</strong></p>
    <p><a class="btn btn-primary" href={SITE.githubPrerelease}>Open the GitHub prerelease</a></p>
    <h2>Native archives</h2>
    <p>Binaries were built from commit <code>07b0abd56bc84fc78532bc2ce8de2c14de9cf29b</code>. After download, verify:</p>
    <pre class="install"><code>sha256sum -c SHA256SUMS</code></pre>
    <p><a href={`${SITE.githubPrereleaseAssets}/SHA256SUMS`}>Download SHA256SUMS</a> · <a href={`${SITE.githubPrereleaseAssets}/goshikq-1.0.0-rc.2.spdx.json`}>SPDX SBOM</a></p>
    <table>
      <thead>
        <tr><th>Platform</th><th>Archive</th><th>SHA256</th></tr>
      </thead>
      <tbody>
        {archives.map((a) => (
          <tr>
            <td>{a.platform}{a.experimental ? " (experimental)" : ""}</td>
            <td><a href={`${SITE.githubPrereleaseAssets}/${a.file}`}>{a.file}</a></td>
            <td><code>{a.sha256}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p><strong>Windows ARM64 is experimental</strong> and is not a required v1.0 platform. Prefer Windows AMD64, Linux, or macOS for this candidate. Production must use a real <code>DATABASE_URL</code> and must not use <code>GOSHIKQ_AUTH_MODE=none</code>.</p>
    <h2>Source</h2>
    <pre class="install"><code>git clone {SITE.githubGit}</code></pre>
    <p><a href={SITE.github}>Open the repository</a></p>
    <h2>Development snapshot ZIP</h2>
    <p>This is the <code>main</code> branch, not the immutable <code>v1.0.0-rc.2</code> tag.</p>
    <p><a class="btn btn-secondary" href={SITE.zipMain}>Download main.zip</a></p>
    <h2>Python</h2>
    <p>Package name <code>{SITE.pythonPackage}</code> version <code>{SITE.pythonVersion}</code> is built locally. It is not on PyPI.</p>
    <pre class="install"><code>python -m pip install -e sdk/python
# extras (experimental providers): pip install -e "sdk/python[openai]" </code></pre>
    <h2>TypeScript / Bun</h2>
    <p><code>{SITE.tsPackage}@{SITE.tsVersion}</code> is not on npm. From the repo root:</p>
    <pre class="install"><code>bun install
bun --filter @goshikq/sdk test</code></pre>
    <h2>Rust runtime from source</h2>
    <pre class="install"><code>cargo run -p goshikq-server
# or: cargo build -p goshikq-server --release</code></pre>
    <h2>Docker</h2>
    <p>Compose file: <code>docker-compose.yml</code>. Postgres, runtime, and Studio images exist in tree. Production must not use <code>GOSHIKQ_AUTH_MODE=none</code>. A published image registry is not claimed.</p>
    <pre class="install"><code>docker compose up -d postgres</code></pre>
    <p>Without Docker: <code>DATABASE_URL=embedded</code>.</p>
  </section>
</Marketing>
