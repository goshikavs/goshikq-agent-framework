---
import Marketing from "../layouts/Marketing.astro";
import { SITE } from "../lib/site";

const archives = [
  { platform: "Linux AMD64", file: "goshikq-1.0.0-rc.1-linux-amd64.tar.gz", sha256: "deb7cff134a2613f87b3d99542635766056e650823fbb78f7b1a46dc3aabbf65", experimental: false },
  { platform: "Linux ARM64", file: "goshikq-1.0.0-rc.1-linux-arm64.tar.gz", sha256: "750bf54ec0deb465aa4ceda40696bcb6569ff70ea32f8cbf7f077fc0ecd102f1", experimental: false },
  { platform: "macOS Intel", file: "goshikq-1.0.0-rc.1-macos-amd64.tar.gz", sha256: "63a09d25182a1db12d7acdf827cdff3acf4de3125ca4e8a45b212351ccee3810", experimental: false },
  { platform: "macOS Apple Silicon", file: "goshikq-1.0.0-rc.1-macos-arm64.tar.gz", sha256: "211e1c58fab3ebe19d5921272f557ab206e235100bad3f947459e166fcec4572", experimental: false },
  { platform: "Windows AMD64", file: "goshikq-1.0.0-rc.1-windows-amd64.zip", sha256: "5986f37f841af76edf149120e806df2d63b5febba3f68894ac16e68eb5a8e4b4", experimental: false },
  { platform: "Windows ARM64", file: "goshikq-1.0.0-rc.1-windows-arm64.zip", sha256: "c318493c2a59117ecf11c8a6427ce334dd4346e396ce268189afbfd11659b106", experimental: true },
];
---
<Marketing title="Install Goshikq v1.0.0-rc.1" description="Download the Goshikq GitHub prerelease archives or install the unpublished Python and TypeScript SDKs from source." path="/download/">
  <section class="hero wrap prose">
    <p class="kicker">Install</p>
    <h1>Install the release candidate</h1>
    <p class="lede"><strong>This is a GitHub prerelease, not stable v1.0.</strong> The published native archives remain <a href={SITE.githubPrerelease}><code>v1.0.0-rc.1</code></a>. In-tree <code>{SITE.version}</code> is not tagged and has no GitHub download assets. There is still no PyPI, npm, or crates.io package. Python <code>{SITE.pythonPackage}=={SITE.pythonVersion}</code> and TypeScript <code>{SITE.tsPackage}@{SITE.tsVersion}</code> install from source. <strong>v1.0.0 is not tagged.</strong></p>
    <p><a class="btn btn-primary" href={SITE.githubPrerelease}>Open the GitHub prerelease</a></p>
    <h2>Native archives</h2>
    <p>Binaries were built from commit <code>1f4d35dd6b73801ede2ec1e64ad906645c4d7a60</code>. After download, verify:</p>
    <pre class="install"><code>sha256sum -c SHA256SUMS</code></pre>
    <p><a href={`${SITE.githubPrereleaseAssets}/SHA256SUMS`}>Download SHA256SUMS</a> · <a href={`${SITE.githubPrereleaseAssets}/goshikq-1.0.0-rc.1.spdx.json`}>SPDX SBOM</a></p>
    <table>
      <thead>
        <tr><th>Platform</th><th>Archive</th><th>SHA256</th></tr>
      </thead>
      <tbody>
        {archives.map((a) => (
          <tr>
            <td>{a.platform}{a.experimental ? " (experimental)" : ""}</td>
            <td><a href={`${SITE.githubPrereleaseAssets}/${a.file}`}>{a.file}</a></td>
            <td><code>{a.sha256}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p><strong>Windows ARM64 is experimental</strong> and is not a required v1.0 platform. Prefer Windows AMD64, Linux, or macOS for this candidate. Production must use a real <code>DATABASE_URL</code> and must not use <code>GOSHIKQ_AUTH_MODE=none</code>.</p>
    <h2>Source</h2>
    <pre class="install"><code>git clone {SITE.githubGit}</code></pre>
    <p><a href={SITE.github}>Open the repository</a></p>
    <h2>Development snapshot ZIP</h2>
    <p>This is the <code>main</code> branch, not the immutable <code>v1.0.0-rc.1</code> tag.</p>
    <p><a class="btn btn-secondary" href={SITE.zipMain}>Download main.zip</a></p>
    <h2>Python</h2>
    <p>Package name <code>{SITE.pythonPackage}</code> version <code>{SITE.pythonVersion}</code> is built locally. It is not on PyPI.</p>
    <pre class="install"><code>python -m pip install -e sdk/python
# extras (experimental providers): pip install -e "sdk/python[openai]" </code></pre>
    <h2>TypeScript / Bun</h2>
    <p><code>{SITE.tsPackage}@{SITE.tsVersion}</code> is not on npm. From the repo root:</p>
    <pre class="install"><code>bun install
bun --filter @goshikq/sdk test</code></pre>
    <h2>Rust runtime from source</h2>
    <pre class="install"><code>cargo run -p goshikq-server
# or: cargo build -p goshikq-server --release</code></pre>
    <h2>Docker</h2>
    <p>Compose file: <code>docker-compose.yml</code>. Postgres, runtime, and Studio images exist in tree. Production must not use <code>GOSHIKQ_AUTH_MODE=none</code>. A published image registry is not claimed.</p>
    <pre class="install"><code>docker compose up -d postgres</code></pre>
    <p>Without Docker: <code>DATABASE_URL=embedded</code>.</p>
  </section>
</Marketing>
